{
  "name": "needle",
  "version": "1.7.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "build": "pnpm --filter ./packages/* --filter ./apps/* build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck && tsc -p . && tsc -p e2e",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "e2e": "playwright test",
    "fixtures": "node e2e/fixtures/make-library.ts",
    "navidrome:test": "docker compose -f e2e/compose.yml up -d --wait",
    "seed": "node --disable-warning=ExperimentalWarning e2e/fixtures/seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2",
    "@needle/shared": "workspace:*"
  }
}
